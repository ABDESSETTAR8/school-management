{
  "name": "scholar-desktop",
  "version": "1.0.0",
  "description": "Scholar — School Management (Windows desktop app)",
  "author": "RACHED MOHAMMED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.scholar.schoolmanagement",
    "productName": "Scholar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "splash.html",
      "build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scholar"
    }
  }
}
